# Local PostgreSQL connection used by the API, migrations, and integration tests.
DATABASE_URL=postgresql://user:password@localhost:5432/resqai

# Port for the process being started.
PORT=8080

# Required by the Vite frontend. Use "/" for a local root preview.
BASE_PATH=/

# Reserved placeholder for the future AI integration. Do not add a real key here.
AI_API_KEY=your_api_key_here